model AiLeadSearchTask {
  id              String   @id @default(uuid())
  userId          String
  userName        String?
  organizationId  String   @default("org-default")
  organizationRole String  @default("member")
  requirement     String
  targetLeadCount Int
  productLineId   String?
  productLineSnapshot Json?
  keywordPlan     Json
  status          AiLeadSearchTaskStatus @default(queued)
  priority        Int      @default(0)
  runVersion      Int      @default(1)
