  readAt          DateTime?
  notifiedAt      DateTime?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  queries AiLeadSearchTaskQuery[]
  events  AiLeadSearchTaskEvent[]
