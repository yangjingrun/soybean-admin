generator client {
  provider = "prisma-client"
  output   = "../apps/server/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model SystemLog {
  id           String   @id @default(uuid())
  level        String
  status       String
  module       String
  action       String
  message      String
  userId       String?
  userName     String?
  errorCode    String?
  errorMessage String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([level])
  @@index([userId])
}

model SystemUser {
  id               String    @id @default(uuid())
  userName         String    @unique
  nickName         String?
  phone            String?
  email            String?
  roles            String[]
  status           String    @default("enabled")
  organizationId   String    @default("org-default")
  organizationRole String    @default("member")
  companyName      String?
  expireAt         DateTime?
  remark           String?
  passwordHash     String
  passwordSalt     String
  lastLoginAt      DateTime?
  lastLoginIp      String?
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  passwordResetAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([status])
  @@index([organizationId])
  @@index([organizationRole])
  @@index([expireAt])
  @@index([lockedUntil])
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  status    String   @default("enabled")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             SystemUser[]
  aiLeadSearchTasks AiLeadSearchTask[]
  crmAccounts       CrmAccount[]
  crmContacts       CrmContact[]
  crmTimelineEvents CrmTimelineEvent[]

  @@index([status])
}

model CrmAccount {
  id             String   @id @default(uuid())
  organizationId String
  ownerUserId    String
  name           String
  normalizedName String
  websiteUrl     String?
  domain         String?
  country        String?
  customerType   String?
  status         String   @default("candidate")
  sourceTaskId   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id])
  contacts     CrmContact[]
  events       CrmTimelineEvent[]

  @@unique([organizationId, ownerUserId, domain])
  @@index([organizationId, ownerUserId, updatedAt])
  @@index([organizationId, status, updatedAt])
  @@index([sourceTaskId])
}

model CrmContact {
  id             String   @id @default(uuid())
  organizationId String
  accountId      String
  ownerUserId    String
  fullName       String?
  title          String?
  email          String
  emailHash      String
  maskedEmail    String
  isPublicEmail  Boolean  @default(false)
  emailStatus    String   @default("unchecked")
  sourceTaskId   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id])
  account      CrmAccount         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  events       CrmTimelineEvent[]

  @@unique([organizationId, ownerUserId, emailHash])
  @@index([organizationId, accountId])
  @@index([organizationId, ownerUserId, updatedAt])
  @@index([organizationId, emailStatus])
  @@index([sourceTaskId])
}

model CrmTimelineEvent {
  id             String   @id @default(uuid())
  organizationId String
  accountId      String
  contactId      String?
  ownerUserId    String
  eventType      String
  title          String
  content        String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  account      CrmAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact      CrmContact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([organizationId, accountId, createdAt])
  @@index([organizationId, contactId, createdAt])
  @@index([eventType, createdAt])
}

model AiPromptConfig {
  id           String   @id @default(uuid())
  promptKey    String   @unique
  title        String
  systemPrompt String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AiModelConfig {
  id              String   @id @default(uuid())
  configKey       String   @unique
  title           String
  providerName    String
  apiBase         String
  apiKey          String
  model           String
  temperature     Float?
  maxOutputTokens Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SerperConfig {
  id        String   @id @default(uuid())
  configKey String   @unique
  title     String
  apiBase   String
  apiKey    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AiLeadKeywordHistory {
  id           String   @id @default(uuid())
  userId       String
  userName     String?
  requirement  String
  resultText   String
  keywordPlan  Json
  finishReason String
  inputTokens  Int?
  outputTokens Int?
  totalTokens  Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, updatedAt])
  @@index([createdAt])
}

model AiLeadSearchTask {
  id              String   @id @default(uuid())
  userId          String
  userName        String?
  organizationId  String   @default("org-default")
  organizationRole String  @default("member")
  requirement     String
  targetLeadCount Int
  keywordPlan     Json
  status          String   @default("queued")
  priority        Int      @default(0)
  runVersion      Int      @default(1)
  progressState   Json?
  result          Json?
  errorMessage    String?
  bullJobId       String?
  readAt          DateTime?
  notifiedAt      DateTime?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  queries AiLeadSearchTaskQuery[]
  events  AiLeadSearchTaskEvent[]
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([userId, status, updatedAt])
  @@index([organizationId, status, updatedAt])
  @@index([status, createdAt])
  @@index([bullJobId])
}

model AiLeadSearchTaskQuery {
  id           String   @id @default(uuid())
  taskId       String
  requestKey   String
  endpoint     String
  requestBody  Json
  status       String   @default("pending")
  result       Json?
  errorMessage String?
  orderIndex   Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  task AiLeadSearchTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, requestKey])
  @@index([taskId, status, orderIndex])
}

model AiLeadSearchTaskEvent {
  id         String   @id @default(uuid())
  taskId     String
  eventType  String
  fromStatus String?
  toStatus   String?
  title      String
  message    String?
  metadata   Json?
  createdAt  DateTime @default(now())

  task AiLeadSearchTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([eventType, createdAt])
}

model SystemNotification {
  id         String   @id @default(uuid())
  userId     String
  userName   String?
  module     String
  type       String
  title      String
  content    String
  targetType String?
  targetId   String?
  routePath  String?
  status     String   @default("pending")
  shownAt    DateTime?
  readAt     DateTime?
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, status, createdAt])
  @@index([targetType, targetId])
}

model AiLeadQueueConfig {
  id                String   @id @default(uuid())
  configKey         String   @unique
  workerConcurrency Int      @default(2)
  priorityStrategy  String   @default("fifo")
  updatedById       String?
  updatedByName     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
