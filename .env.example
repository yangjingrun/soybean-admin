# Frontend
VITE_BASE_URL=/
VITE_APP_TITLE=SoybeanAdmin
VITE_APP_DESC=SoybeanAdmin is a fresh and elegant admin template
VITE_AUTH_ROUTE_MODE=static
VITE_ROUTE_HOME=home
VITE_HTTP_PROXY=Y
VITE_ROUTER_HISTORY_MODE=history
VITE_SERVICE_SUCCESS_CODE=0000
VITE_SERVICE_LOGOUT_CODES=8888,8889
VITE_SERVICE_MODAL_LOGOUT_CODES=7777,7778
VITE_SERVICE_EXPIRED_TOKEN_CODES=9999,9998,3333
VITE_STATIC_SUPER_ROLE=R_SUPER
VITE_SOURCE_MAP=N
VITE_STORAGE_PREFIX=SOY_
VITE_SERVICE_BASE_URL=https://<api-domain>
VITE_OTHER_SERVICE_BASE_URL={}

# Backend base services
NODE_ENV=production
PORT=9528
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>?schema=public
REDIS_URL=redis://<host>:6379
SERVER_CORS_ORIGINS=https://<app-domain>

# Gmail OAuth / sending / history sync
CRM_GMAIL_OAUTH_CLIENT_ID=<google-oauth-client-id>
CRM_GMAIL_OAUTH_CLIENT_SECRET=<google-oauth-client-secret>
CRM_GMAIL_OAUTH_REDIRECT_URI=https://<app-domain>/crm/gmail-oauth-callback
CRM_GMAIL_TOKEN_ENCRYPTION_KEY=<stable-32-byte-or-longer-secret>
CRM_GMAIL_OAUTH_STATE_SECRET=<stable-random-state-secret>
CRM_GMAIL_PUBSUB_TOPIC_NAME=projects/<project-id>/topics/<topic-name>
CRM_GMAIL_PUBSUB_PUSH_SECRET=<pubsub-push-header-secret>
CRM_GMAIL_WATCH_RENEWAL_DISABLED=false
CRM_GMAIL_WATCH_RENEWAL_INTERVAL_MS=21600000
CRM_GMAIL_WATCH_RENEWAL_WINDOW_MS=86400000
CRM_GMAIL_WATCH_RENEWAL_BATCH_SIZE=50

# Debug only. Keep unset/false in production.
CRM_ENABLE_MOCK_ENDPOINTS=false
